# ── English ──────────────────────────────────────────────────
# Notion integration token — from notion.so/my-integrations
# ── Español ──────────────────────────────────────────────────
# Token de integración de Notion — desde notion.so/my-integrations
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── English ──────────────────────────────────────────────────
# Your Notion database ID — the 32-character string from the database URL
# ── Español ──────────────────────────────────────────────────
# ID de tu base de datos de Notion — los 32 caracteres de la URL
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── English ──────────────────────────────────────────────────
# Password to access the dashboard (you choose it)
# ── Español ──────────────────────────────────────────────────
# Contraseña para acceder al dashboard (la eliges tú)
VITE_APP_PASSWORD=choose_a_strong_password
